<mxfile host="app.diagrams.net" modified="2026-10-26T00:00:00.000Z" agent="DS-Agent" version="21.0.0" type="device">   <diagram id="ds-agent-arch" name="DS-Agent Architecture">     <mxGraphModel dx="1200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1800" math="0" shadow="0">       <root>         <mxCell id="0"/>         <mxCell id="1" parent="0"/>         <mxCell id="USER" value="Business Stakeholder / Analyst" style="whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=50;" vertex="1" parent="1">   <mxGeometry x="420" y="40" width="260" height="50" as="geometry"/> </mxCell>         <mxCell id="API" value="FastAPI / SSE Stream &amp;amp; CLI REPL" style="whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="425" y="140" width="250" height="55" as="geometry"/> </mxCell>         <mxCell id="GUARD" value="1. Ingress Guard&#xa;(SQLi, DDL/DML Filter)" style="whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;strokeWidth=1.5;fontStyle=1;shape=rhombus;" vertex="1" parent="1">   <mxGeometry x="460" y="245" width="180" height="100" as="geometry"/> </mxCell>         <mxCell id="REJECT" value="Security Rejection" style="whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=50;" vertex="1" parent="1">   <mxGeometry x="120" y="270" width="180" height="50" as="geometry"/> </mxCell>         <mxCell id="ROUTER" value="2. 3-Signal Intent Router&#xa;(Rules + Catalog Classifier + Model)" style="whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="415" y="395" width="270" height="65" as="geometry"/> </mxCell>         <mxCell id="RESOLVER" value="3. Metric Resolver" style="whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#166534;strokeWidth=1.5;fontStyle=1;shape=rhombus;" vertex="1" parent="1">   <mxGeometry x="200" y="515" width="160" height="90" as="geometry"/> </mxCell>         <mxCell id="PERCEPTOR" value="4. Schema Perceptor &amp;amp; Value Linker" style="whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="440" y="530" width="250" height="60" as="geometry"/> </mxCell>         <mxCell id="REFUSAL" value="Refusal (ABS-1)" style="whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=50;" vertex="1" parent="1">   <mxGeometry x="780" y="535" width="180" height="50" as="geometry"/> </mxCell>         <mxCell id="COMPILER" value="Deterministic SQL Compiler&#xa;(Strict Jinja2 AST; Zero-LLM)" style="whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#166534;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="150" y="660" width="250" height="65" as="geometry"/> </mxCell>         <mxCell id="GENERATOR" value="4-Stage SQL Generator&#xa;(CTE Skeletons + Catalog Joins)" style="whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="440" y="660" width="250" height="65" as="geometry"/> </mxCell>         <mxCell id="VALIDATOR" value="5. AST Validator&#xa;(Dual-Mode: Enterprise vs Benchmark)" style="whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;strokeWidth=1.5;fontStyle=1;shape=rhombus;" vertex="1" parent="1">   <mxGeometry x="445" y="775" width="220" height="110" as="geometry"/> </mxCell>         <mxCell id="REPAIRER" value="Self-Repair Reflector&#xa;(Max 2 Tries; Frozen Schema)" style="whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="760" y="795" width="230" height="65" as="geometry"/> </mxCell>         <mxCell id="CLARIFY" value="Clarification Envelope" style="whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=50;" vertex="1" parent="1">   <mxGeometry x="785" y="915" width="180" height="50" as="geometry"/> </mxCell>         <mxCell id="GATEWAY" value="6. Read-Only Gateway&#xa;(SQLite / Pool, 10s Budget)" style="whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontColor=#6b21a8;strokeWidth=1.5;fontStyle=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">   <mxGeometry x="445" y="935" width="220" height="70" as="geometry"/> </mxCell>         <mxCell id="RECON" value="7. Result Reconciler&#xa;(Grain, Nulls, Fan-out, Registry)" style="whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;strokeWidth=1.5;fontStyle=1;shape=rhombus;" vertex="1" parent="1">   <mxGeometry x="450" y="1055" width="210" height="100" as="geometry"/> </mxCell>         <mxCell id="LEDGER" value="8. Evidence Ledger&#xa;(Numbered Claims C1..Cn)" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;strokeWidth=1.5;fontStyle=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">   <mxGeometry x="190" y="1215" width="220" height="70" as="geometry"/> </mxCell>         <mxCell id="ANALYSTS" value="9. Statistical Analysts (Pure Python)&#xa;• Anomaly: STL / ETS + PELT + FDR&#xa;• Driver: Price/Volume/Mix + DiD + Bootstrap&#xa;• Risk: Chronological Churn Model" style="whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#9a3412;strokeWidth=1.5;fontStyle=1;rounded=1;arcSize=10;" vertex="1" parent="1">   <mxGeometry x="490" y